    "VAL_SIZE = 0             # 0 = final run on all 50k images; 5000 = experiment mode (shows val accuracy)\n",
    "\n",
    "perm = torch.randperm(len(X_all), generator=torch.Generator().manual_seed(SEED))\n",
    "val_idx, tr_idx = perm[:VAL_SIZE], perm[VAL_SIZE:]\n",
    "\n",
    "MEAN = torch.tensor([0.4914, 0.4822, 0.4465], device=device).view(1, 3, 1, 1)\n",
    "STD  = torch.tensor([0.2470, 0.2435, 0.2616], device=device).view(1, 3, 1, 1)\n",
    "def to_gpu(x):  # uint8 -> normalized float on GPU\n",
    "    return ((x.to(device).float() / 255) - MEAN) / STD\n",
    "\n",
    "Xtr, ytr = to_gpu(X_all[tr_idx]), y_all[tr_idx].to(device)\n",
    "Xva, yva = to_gpu(X_all[val_idx]), y_all[val_idx].to(device)\n",
    "Xte = to_gpu(X_test)\n",
    "print('train', Xtr.shape, '| val', Xva.shape, '| test', Xte.shape)\n",
    "\n",
    "def augment(x, pad=4, cutout=16):\n",
    "    # Random crop (reflect pad), horizontal flip, cutout — all on GPU, per image.\n",
    "    N, C, H, W = x.shape\n",
    "    xp = F.pad(x, (pad,) * 4, mode='reflect')\n",
    "    i = torch.randint(0, 2 * pad + 1, (N,), device=x.device)\n",
    "    j = torch.randint(0, 2 * pad + 1, (N,), device=x.device)\n",
    "    ar = torch.arange(H, device=x.device)\n",
    "    rows = (i[:, None] + ar)[:, None, :, None].expand(N, C, H, W)\n",
    "    cols = (j[:, None] + ar)[:, None, None, :].expand(N, C, H, W)\n",
    "    x = xp[torch.arange(N, device=x.device)[:, None, None, None],\n",
    "           torch.arange(C, device=x.device)[None, :, None, None], rows, cols]\n",
    "    flip = torch.rand(N, device=x.device) < 0.5\n",
    "    x = torch.where(flip[:, None, None, None], x.flip(3), x)\n",
    "    if cutout:\n",
    "        cy = torch.randint(0, H, (N,), device=x.device)[:, None, None]\n",
    "        cx = torch.randint(0, W, (N,), device=x.device)[:, None, None]\n",
    "        yy, xx = ar[None, :, None], ar[None, None, :]\n",
    "        m = ((yy - cy).abs() < cutout // 2) & ((xx - cx).abs() < cutout // 2)\n",
    "        x = x * (~m)[:, None].float()\n",
    "    return x"
   ]
