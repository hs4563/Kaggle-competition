    "import re\n",
    "CLASSES = ['airplane', 'automobile', 'bird', 'cat', 'deer', 'dog', 'frog', 'horse', 'ship', 'truck']\n",
    "def load_img(p):\n",
    "    return torch.from_numpy(np.array(Image.open(p).convert('RGB'))).permute(2, 0, 1)\n",
    "def num(s):\n",
    "    d = re.findall(r'\\d+', str(s)); return int(d[-1]) if d else None\n",
    "\n",
    "sample = pd.read_csv(next(c for c in csv_files if 'sample' in c.name.lower()))\n",
    "\n",
    "# ---- test images: the folder with exactly as many PNGs as sample_submission rows ----\n",
