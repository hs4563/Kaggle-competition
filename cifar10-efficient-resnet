    "    cand = [d for d, ps in dirs.items() if len(ps) == len(sample)] or [d for d in dirs if 'test' in str(d).lower()]\n",
    "    TEST_DIR = cand[0]\n",
    "tpaths = {num(p.stem): p for p in dirs[Path(TEST_DIR)]}\n",
    "missing = [i for i in sample['id'] if num(i) not in tpaths]\n",
    "assert not missing, f'{len(missing)} test ids have no image, e.g. {missing[:5]}'\n",
    "X_test = torch.stack([load_img(tpaths[num(i)]) for i in sample['id']])\n",
    "print('TEST_DIR =', TEST_DIR, '| test:', tuple(X_test.shape))\n",
    "\n",
    "# ---- training images ----\n",
    "train_pngs = [p for d, ps in dirs.items() if d != Path(TEST_DIR) for p in ps]\n",
    "label_csv = None\n",
    "for c in csv_files:\n",
