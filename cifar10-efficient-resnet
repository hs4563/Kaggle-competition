    "## 4. Model: wide pre-activation ResNet (≤ 5M params)\n",
    "\n",
    "`F(x)` = BN → ReLU → Conv3×3 → BN → ReLU → Conv3×3; `S(x)` = identity, or a 1×1 conv projection when shape changes.\n",
    "Knobs to experiment with: `widths`, `blocks`, kernel size, dropout before the classifier."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "36566318",
   "metadata": {},
   "outputs": [],
   "source": [
    "class PreActBlock(nn.Module):\n",
    "    def __init__(self, cin, cout, stride=1, k=3):\n",
    "        super().__init__()\n",
    "        self.bn1 = nn.BatchNorm2d(cin)\n",
    "        self.conv1 = nn.Conv2d(cin, cout, k, stride, k // 2, bias=False)\n",
    "        self.bn2 = nn.BatchNorm2d(cout)\n",
    "        self.conv2 = nn.Conv2d(cout, cout, k, 1, k // 2, bias=False)\n",
    "        self.shortcut = None\n",
    "        if stride != 1 or cin != cout:\n",
    "            self.shortcut = nn.Conv2d(cin, cout, 1, stride, bias=False)   # learned projection S(x)\n",
    "\n",
    "    def forward(self, x):\n",
    "        out = F.relu(self.bn1(x))\n",
    "        s = self.shortcut(out) if self.shortcut is not None else x       # identity S(x)\n",
    "        out = self.conv1(out)\n",
    "        out = self.conv2(F.relu(self.bn2(out)))\n",
    "        return out + s                                                   # F(x) + S(x)\n",
    "\n",
    "class ResNet(nn.Module):\n",
    "    def __init__(self, widths=(64, 128, 256, 352), blocks=(2, 2, 2, 1), num_classes=10, drop=0.0):\n",
    "        super().__init__()\n",
    "        self.stem = nn.Conv2d(3, widths[0], 3, 1, 1, bias=False)\n",
    "        layers, cin = [], widths[0]\n",
    "        for s, (w, n) in enumerate(zip(widths, blocks)):\n",
    "            for b in range(n):\n",
    "                layers.append(PreActBlock(cin, w, stride=2 if (b == 0 and s > 0) else 1))\n",
    "                cin = w\n",
    "        self.layers = nn.Sequential(*layers)\n",
    "        self.bn = nn.BatchNorm2d(cin)\n",
    "        self.drop = nn.Dropout(drop)\n",
    "        self.fc = nn.Linear(cin, num_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = self.layers(self.stem(x))\n",
    "        x = F.relu(self.bn(x))\n",
    "        x = F.adaptive_avg_pool2d(x, 1).flatten(1)\n",
    "        return self.fc(self.drop(x))\n",
    "\n",
    "def count_params(m): return sum(p.numel() for p in m.parameters() if p.requires_grad)\n",
    "\n",
    "model = ResNet().to(device).to(memory_format=torch.channels_last)\n",
    "n_params = count_params(model)\n",
    "print(f'Trainable parameters: {n_params:,}')\n",
    "assert n_params <= 5_000_000, 'Over the 5M budget!'"
   ]
