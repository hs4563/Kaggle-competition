    "## 5. Training setup\n",
    "\n",
    "- **CutMix** (`USE_CUTMIX`): with probability `CUTMIX_PROB`, a random box from another image in the batch is pasted in and the label is mixed by box area. Off for the last `CUTMIX_OFF_LAST` epochs.\n",
    "- **EMA** (`USE_EMA`): exponential moving average of the weights (`EMA_DECAY`), used for evaluation and predictions.\n",
    "- **SAM** (`USE_SAM`): Sharpness-Aware Minimization, radius `SAM_RHO`; favours flat minima. ~2× time per epoch.\n",
    "- **Distillation** (student only): loss = `(1 - KD_ALPHA) * normal loss + KD_ALPHA * T² * KL(student || teacher ensemble)` at temperature `KD_T`. Teachers see exactly the same augmented image as the student.\n",
    "- **TTA** (`TTA_FULL`): final predictions average 10 views (original + 4 two-pixel shifts, each also flipped)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fcd7b36b",
   "metadata": {},
   "outputs": [],
   "source": [
    "import copy\n",
    "\n",
    "N_TEACHERS      = 2       # teachers trained in this run (~70 min each)\n",
    "EPOCHS          = 200     # for the student\n",
    "TEACHER_EPOCHS  = 200\n",
    "BATCH           = 256\n",
    "LR              = 0.2\n",
    "WD              = 5e-4\n",
    "SMOOTHING       = 0.1\n",
    "\n",
    "USE_CUTMIX      = True\n",
    "CUTMIX_PROB     = 0.5\n",
    "CUTMIX_OFF_LAST = 10\n",
    "USE_EMA         = True\n",
    "EMA_DECAY       = 0.999\n",
    "USE_SAM         = True\n",
    "SAM_RHO         = 0.05\n",
    "TTA_FULL        = True\n",
    "KD_ALPHA        = 0.8\n",
    "KD_T            = 4.0\n",
    "\n",
    "criterion = nn.CrossEntropyLoss(label_smoothing=SMOOTHING)\n",
    "\n",
    "def cutmix(x, y):\n",
    "    N, _, H, W = x.shape\n",
    "    perm = torch.randperm(N, device=x.device)\n",
    "    lam = float(np.random.beta(1.0, 1.0))\n",
    "    ch, cw = int(H * math.sqrt(1 - lam)), int(W * math.sqrt(1 - lam))\n",
    "    cy, cx = np.random.randint(H), np.random.randint(W)\n",
    "    y1, y2 = max(cy - ch // 2, 0), min(cy + ch // 2, H)\n",
    "    x1, x2 = max(cx - cw // 2, 0), min(cx + cw // 2, W)\n",
    "    x = x.clone()\n",
    "    x[:, :, y1:y2, x1:x2] = x[perm, :, y1:y2, x1:x2]\n",
    "    lam = 1 - (y2 - y1) * (x2 - x1) / (H * W)\n",
    "    return x, y, y[perm], lam\n",
    "\n",
    "class EMA:\n",
    "    def __init__(self, model, decay):\n",
    "        self.decay = decay\n",
    "        self.model = copy.deepcopy(model).eval()\n",
    "        for p in self.model.parameters(): p.requires_grad_(False)\n",
    "    @torch.no_grad()\n",
    "    def update(self, model):\n",
    "        msd = model.state_dict()\n",
    "        for k, v in self.model.state_dict().items():\n",
    "            if v.dtype.is_floating_point: v.lerp_(msd[k], 1 - self.decay)\n",
    "            else: v.copy_(msd[k])\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_logits(m, X, bs=1000, tta='flip'):\n",
    "    # tta: None = single view, 'flip' = original + flip, 'full' = original + 4 shifts (2 px), each with its flip\n",
    "    m.eval(); out = []\n",
    "    shifts = [(0, 0)] + ([(-2, 0), (2, 0), (0, -2), (0, 2)] if tta == 'full' else [])\n",
    "    for k in range(0, len(X), bs):\n",
    "        xp = F.pad(X[k:k + bs], (2, 2, 2, 2), mode='reflect')\n",
    "        lo = 0\n",
    "        for dy, dx in shifts:\n",
    "            v = xp[:, :, 2 + dy:34 + dy, 2 + dx:34 + dx].contiguous(memory_format=torch.channels_last)\n",
    "            with torch.autocast('cuda', dtype=torch.float16):\n",
    "                lo = lo + m(v).float()\n",
    "                if tta: lo = lo + m(v.flip(3)).float()\n",
    "        out.append(lo)\n",
    "    return torch.cat(out)\n",
    "\n",
    "@torch.no_grad()\n",
    "def teacher_logits(teachers, x):\n",
    "    with torch.autocast('cuda', dtype=torch.float16):\n",
    "        return torch.stack([t(x).float() for t in teachers])      # (n_teachers, N, 10)\n",
    "\n",
    "def sam_step(model, opt, scaler, xb, loss_fn):\n",
    "    # SAM with mixed precision: grads at w -> perturb to w + rho*g/|g| -> grads there -> restore w -> step.\n",
    "    with torch.autocast('cuda', dtype=torch.float16):\n",
    "        logits = model(xb); loss = loss_fn(logits)\n",
    "    opt.zero_grad(set_to_none=True)\n",
    "    scaler.scale(loss).backward()\n",
    "    inv_scale = 1.0 / scaler.get_scale()\n",
    "    params = [p for p in model.parameters() if p.grad is not None]\n",
    "    gnorm = torch.norm(torch.stack([p.grad.norm(2) for p in params]), 2) * inv_scale\n",
    "    eps = None\n",
    "    if torch.isfinite(gnorm):\n",
    "        with torch.no_grad():\n",
    "            eps = [p.grad * (inv_scale * SAM_RHO / (gnorm + 1e-12)) for p in params]\n",
    "            for p, e in zip(params, eps): p.add_(e)\n",
    "    with torch.autocast('cuda', dtype=torch.float16):\n",
    "        loss2 = loss_fn(model(xb))\n",
    "    opt.zero_grad(set_to_none=True)\n",
    "    scaler.scale(loss2).backward()\n",
    "    if eps is not None:\n",
    "        with torch.no_grad():\n",
    "            for p, e in zip(params, eps): p.sub_(e)\n",
    "    scaler.step(opt); scaler.update()\n",
    "    return logits, loss\n",
    "\n",
    "def train_model(seed, epochs, teachers=(), name='model'):\n",
    "    # Trains one ResNet from scratch. With teachers, adds the distillation loss. Returns (final model, history).\n",
    "    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)\n",
    "    model = ResNet().to(device).to(memory_format=torch.channels_last)\n",
    "    opt = torch.optim.SGD(model.parameters(), lr=LR, momentum=0.9, nesterov=True, weight_decay=WD)\n",
    "    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=LR, epochs=epochs, steps_per_epoch=math.ceil(len(Xtr) / BATCH),\n",
    "                                                pct_start=0.15, div_factor=10, final_div_factor=200)\n",
    "    scaler = torch.amp.GradScaler('cuda')\n",
    "    ema = EMA(model, EMA_DECAY) if USE_EMA else None\n",
    "    history = []\n",
    "    print(f'===== training {name} (seed {seed}, {epochs} epochs, {len(teachers)} teachers) =====')\n",
    "    for epoch in range(epochs):\n",
    "        model.train(); t0 = time.time()\n",
    "        use_cm = USE_CUTMIX and epoch < epochs - CUTMIX_OFF_LAST\n",
    "        order = torch.randperm(len(Xtr), device=device)\n",
    "        tot_loss, correct = 0.0, 0\n",
    "        for k in range(0, len(Xtr), BATCH):\n",
    "            idx = order[k:k + BATCH]\n",
    "            xb, yb = augment(Xtr[idx]), ytr[idx]\n",
    "            mixed = use_cm and np.random.rand() < CUTMIX_PROB\n",
    "            if mixed:\n",
    "                xb, ya, yb2, lam = cutmix(xb, yb)\n",
    "            xb = xb.contiguous(memory_format=torch.channels_last)\n",
    "            if mixed:\n",
    "                base_fn = lambda lo: lam * criterion(lo, ya) + (1 - lam) * criterion(lo, yb2)\n",
    "            else:\n",
    "                base_fn = lambda lo: criterion(lo, yb)\n",
    "            if teachers:\n",
    "                t_prob = (teacher_logits(teachers, xb) / KD_T).softmax(2).mean(0)\n",
    "                loss_fn = lambda lo: (1 - KD_ALPHA) * base_fn(lo) + KD_ALPHA * KD_T ** 2 * \\\n",
    "                    F.kl_div(F.log_softmax(lo.float() / KD_T, 1), t_prob, reduction='batchmean')\n",
    "            else:\n",
    "                loss_fn = base_fn\n",
    "            if USE_SAM:\n",
    "                logits, loss = sam_step(model, opt, scaler, xb, loss_fn)\n",
    "            else:\n",
    "                with torch.autocast('cuda', dtype=torch.float16):\n",
