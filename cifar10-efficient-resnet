    "    key_col = [k for k in label_csv.columns if k != 'label'][0]\n",
    "    by_stem = {p.stem: p for p in train_pngs}\n",
    "    by_num = {num(p.stem): p for p in train_pngs}\n",
    "    def find(k):\n",
